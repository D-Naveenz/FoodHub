<Page x:Class="FoodHub.Pages.MenuPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" xmlns:controls="using:FoodHub.Controls">
 <Grid Padding="24" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Find your next favourite" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Fresh choices from our takeaway"/></StackPanel>
   <Button Grid.Column="1" x:Name="BasketButton" Click="Basket_Click" VerticalAlignment="Center"/>
  </Grid>
  <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent">
   <CommandBar.Content><StackPanel Orientation="Horizontal" Spacing="12">
    <AutoSuggestBox x:Name="Search" Width="240" PlaceholderText="Search meals by name" QueryIcon="Find" TextChanged="Search_Changed" AutomationProperties.Name="Search menu"/>
    <ComboBox x:Name="Sort" Width="170" SelectedIndex="0" SelectionChanged="Sort_Changed" AutomationProperties.Name="Sort meals">
     <x:String>Menu order</x:String><x:String>Name</x:String><x:String>Price: low to high</x:String><x:String>Price: high to low</x:String>
    </ComboBox>
   </StackPanel></CommandBar.Content>
   <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click"/>
  </CommandBar>
  <StackPanel Grid.Row="2" Spacing="8">
   <toolkit:TokenView x:Name="Categories" SelectionMode="Single" CanRemoveTokens="False" IsWrapped="True" SelectionChanged="Category_Changed" AutomationProperties.Name="Menu categories"/>
   <ToggleButton x:Name="AvailableOnly" Content="Available only" Click="Availability_Click"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Spacing="8"><ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed"/>
   <InfoBar x:Name="Feedback" IsOpen="False" IsClosable="False" Severity="Warning"/>
   <TextBlock x:Name="Empty" Text="No meals match these filters." Visibility="Collapsed"/>
  </StackPanel>
  <ItemsView x:Name="Meals" Grid.Row="4" SelectionMode="None" IsItemInvokedEnabled="False">
   <ItemsView.Layout><UniformGridLayout MinItemWidth="260" MinItemHeight="480" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill"/></ItemsView.Layout>
   <ItemsView.ItemTemplate><DataTemplate><ItemContainer><controls:MealCard/></ItemContainer></DataTemplate></ItemsView.ItemTemplate>
  </ItemsView>
 </Grid>
</Page>