<Page x:Class="FoodHub.Pages.Account.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Padding="24">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Text="Welcome back" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <StackPanel x:Name="Fields" Spacing="16">
                <TextBox x:Name="EmailBox" Header="Email" MaxLength="254" InputScope="EmailSmtpAddress"
                         Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox x:Name="Password" Header="Password" PasswordRevealMode="Peek" KeyDown="Password_KeyDown" />
                <CheckBox Content="Stay signed in" IsChecked="{x:Bind ViewModel.Remember, Mode=TwoWay}" />
            </StackPanel>
            <InfoBar x:Name="Feedback" Severity="Error" IsClosable="False"
                     Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
            <ProgressRing x:Name="BusyIndicator" Visibility="Collapsed"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="24" Height="24" HorizontalAlignment="Left" />
            <Button Content="Log in" Command="{x:Bind ViewModel.SubmitCommand}"
                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="New Customer?" VerticalAlignment="Center" />
                <HyperlinkButton x:Name="SwitchLink" Content="Register" Click="Register_Click" Padding="4,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
