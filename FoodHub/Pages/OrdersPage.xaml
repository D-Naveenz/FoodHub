<Page x:Class="FoodHub.Pages.OrdersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="20" MaxWidth="1000" HorizontalAlignment="Stretch">
  <TextBlock Text="Your orders" Style="{StaticResource TitleTextBlockStyle}"/>
  <Button x:Name="RefreshButton" Content="Refresh orders" Click="Refresh_Click"/>
  <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed"/>
  <InfoBar x:Name="Feedback" IsOpen="False" IsClosable="False" Severity="Warning"/>
  <Button x:Name="RetryPlacement" Content="I checked history; allow a new order attempt" Click="RetryPlacement_Click" Visibility="Collapsed"/>
  <TextBlock Text="Active orders" Style="{StaticResource SubtitleTextBlockStyle}"/>
  <StackPanel x:Name="Active" Spacing="12"/>
  <TextBlock Text="Past orders" Style="{StaticResource SubtitleTextBlockStyle}"/>
  <StackPanel x:Name="Past" Spacing="12"/>
 </StackPanel></ScrollViewer>
</Page>