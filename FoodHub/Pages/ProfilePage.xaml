<Page x:Class="FoodHub.Pages.ProfilePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel Padding="32" Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
  <TextBlock Text="Your profile" Style="{StaticResource TitleTextBlockStyle}"/>
  <StackPanel Orientation="Horizontal" Spacing="16"><PersonPicture x:Name="ProfileAvatar" Width="80" Height="80"/><TextBlock x:Name="ProfileTitle" Text="Guest" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/></StackPanel>
  <StackPanel x:Name="GuestPanel" Spacing="16">
   <TextBlock Text="Welcome, Guest. Sign in to save your contact details, delivery addresses and orders." TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Log in" Click="Login_Click" Style="{StaticResource AccentButtonStyle}"/><Button Content="Register" Click="Register_Click"/></StackPanel>
  </StackPanel>
  <StackPanel x:Name="AccountPanel" Spacing="20" Visibility="Collapsed">
   <StackPanel x:Name="Editor" Spacing="16">
    <TextBlock Text="Account and contact details" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <TextBox Header="Email" IsReadOnly="True" Text="{x:Bind ViewModel.Email, Mode=OneWay}"/>
    <TextBox Header="Display name" MaxLength="80" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="Full name" MaxLength="150" Text="{x:Bind ViewModel.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="Phone number" MaxLength="32" Text="{x:Bind ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
   </StackPanel>
   <Button Content="Save details" Command="{x:Bind ViewModel.SaveBasicsCommand}" Style="{StaticResource AccentButtonStyle}"/>
   <TextBlock Text="Profile photo" Style="{StaticResource SubtitleTextBlockStyle}"/>
   <TextBlock Text="PNG or JPEG, up to 5 MB and 4096 × 4096 pixels." TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Choose photo" Command="{x:Bind ViewModel.PhotoCommand}"/><Button Content="Remove photo" Command="{x:Bind ViewModel.RemovePhotoCommand}"/></StackPanel>
   <TextBlock Text="Delivery addresses" Style="{StaticResource SubtitleTextBlockStyle}"/>
   <ComboBox x:Name="AddressPicker" Header="Saved addresses" ItemsSource="{x:Bind ViewModel.Addresses}" SelectedItem="{x:Bind ViewModel.SelectedAddress, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch"/>
   <Button Content="New address" Command="{x:Bind ViewModel.NewAddressCommand}"/>
   <StackPanel x:Name="AddressEditor" Spacing="12">
    <TextBox Header="Label (e.g. Home)" MaxLength="40" Text="{x:Bind ViewModel.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="Address line 1" MaxLength="200" Text="{x:Bind ViewModel.Line1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="Address line 2 (optional)" MaxLength="200" Text="{x:Bind ViewModel.Line2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="City" MaxLength="100" Text="{x:Bind ViewModel.City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Header="Postal code (optional)" MaxLength="20" Text="{x:Bind ViewModel.PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Save address" Command="{x:Bind ViewModel.SaveAddressCommand}"/><Button Content="Delete address" Command="{x:Bind ViewModel.DeleteAddressCommand}"/></StackPanel>
  </StackPanel>
  <InfoBar x:Name="Feedback" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.Message, Mode=OneWay}"/>
  <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left"/>
  <Button x:Name="SignOutButton" Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" Visibility="Collapsed"/>
 </StackPanel></ScrollViewer>
</Page>
