<UserControl x:Class="FoodHub.Controls.MealCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FoodHub.Controls">
    <Border x:Name="CardBorder" VerticalAlignment="Top" CornerRadius="12" BorderThickness="2" Padding="12" Margin="4"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        PointerEntered="Card_Entered" PointerExited="Card_Exited">
        <StackPanel Spacing="12">
            <!-- The body button and quantity buttons are siblings: invoking one never invokes the other. -->
            <Button x:Name="BodyButton" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" Click="Open_Click">
                <StackPanel Spacing="10">
                    <Grid>
                        <Border CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Image x:Name="Photo" Height="180" Stretch="UniformToFill"/>
                        </Border>
                        <Border x:Name="QuantityBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="14" Padding="9,4"
                            Margin="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                            <TextBlock x:Name="BadgeText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="MealName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Price" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="Availability" Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Button>
            <local:QuantityEditor x:Name="Editor"/>
        </StackPanel>
    </Border>
</UserControl>
