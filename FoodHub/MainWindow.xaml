<Window x:Class="FoodHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="FoodHub">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" 
                  Title="FoodHub" 
                  BackRequested="TitleBar_BackRequested"
                  IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}" 
                  IsPaneToggleButtonVisible="True" 
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico"/>
            </TitleBar.IconSource>
        </TitleBar>
        <InfoBar x:Name="SessionFeedback" Grid.Row="1" Severity="Warning" IsClosable="True" Title="Account" Message="{x:Bind Session.Message, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Content="Retry account connection" Click="Retry_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>
        <NavigationView x:Name="NavView" 
                        Grid.Row="2" 
                        IsBackButtonVisible="Collapsed" 
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneCustomContent>
                <Button x:Name="ProfileButton" 
                        Click="Profile_Click" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="4,6" 
                        Margin="4,0"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Left" 
                        AutomationProperties.Name="Open your profile">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PersonPicture x:Name="Avatar" 
                                       Width="32" 
                                       Height="32" 
                                       DisplayName="{x:Bind Session.DisplayName, Mode=OneWay}"/>
                        <TextBlock x:Name="ProfileName" 
                                   Text="{x:Bind Session.DisplayName, Mode=OneWay}" 
                                   VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxWidth="200"/>
                    </StackPanel>
                </Button>
            </NavigationView.PaneCustomContent>
            <NavigationView.MenuItems>
                <!-- Separator appears directly below PaneCustomContent -->
                <NavigationViewItemSeparator />
                
                <NavigationViewItem Content="Home" Tag="home" Icon="Home"/>
                <NavigationViewItem Content="Menu" Tag="menu">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Basket" Tag="basket">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Orders" Tag="orders">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="NavFrame" Navigated="Frame_Navigated"/>
        </NavigationView>
    </Grid>
</Window>
