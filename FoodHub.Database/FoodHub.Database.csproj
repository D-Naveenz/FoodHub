<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Native settings need the Windows App SDK runtime, but never a XAML Application or message loop. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FoodHub.Core/FoodHub.Core.csproj"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <!-- This executable shares the application's default sources; Dhara owns the generic copy rules. -->
    <DharaAppSettingsDirectory>$(MSBuildProjectDirectory)/../FoodHub</DharaAppSettingsDirectory>
  </PropertyGroup>
  <!-- Project references do not auto-import package build assets. NuGet consumers get this transitively. -->
  <Import Project="../Dhara/Dhara.Extensions.WinUI/buildTransitive/Dhara.Extensions.WinUI.targets" />
</Project>
